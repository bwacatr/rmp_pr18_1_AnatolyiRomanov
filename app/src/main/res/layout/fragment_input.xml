<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".InputFragment"
    android:background="@color/black">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:textSize="20sp"
        android:paddingTop="10dp"
        android:background="@drawable/rectangle"
        android:textScaleX="1.3"

        android:textAlignment="center"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:text="@string/createVariantText" />

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/rectangle"
        android:layout_gravity="center">
        <TextView
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enterTheme1"
            android:textColor="@color/black"
            android:textAlignment="center"
            android:textSize="18sp"
            />

        <EditText
            android:layout_marginTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:textColorHint="@color/black"
            android:hint="@string/enterTheme1"
            android:background="@drawable/white_rectangle"
            android:textAlignment="center"
            android:id="@+id/themeEdit1"

            />

        <TextView

            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enterTheme2"
            android:textColor="@color/black"
            android:textAlignment="center"
            android:textSize="18sp"
            />

        <EditText
            android:background="@drawable/white_rectangle"
            android:height="40dp"
            android:layout_marginTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColorHint="@color/black"
            android:hint="@string/enterTheme2"

            android:textAlignment="center"

            android:id="@+id/themeEdit2"

            />

        <TextView

            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enterTheme3"
            android:textColor="@color/black"
            android:textAlignment="center"
            android:textSize="18sp"
            />

        <EditText
            android:background="@drawable/white_rectangle"
            android:height="40dp"
            android:layout_marginTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColorHint="@color/black"
            android:hint="@string/enterTheme3"

            android:textAlignment="center"
            android:id="@+id/themeEdit3"

            />

        <TextView

            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enterTheme4"
            android:textColor="@color/black"
            android:textAlignment="center"
            android:textSize="18sp"
            />

        <EditText
            android:background="@drawable/white_rectangle"
            android:height="40dp"
            android:layout_marginTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColorHint="@color/black"
            android:hint="@string/enterTheme4"

            android:textAlignment="center"

            android:layout_marginBottom="10dp"

            android:id="@+id/themeEdit4"
            />

    </LinearLayout>

    <RelativeLayout
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="300dp"

            android:layout_height="100dp"
            android:textAlignment="center"
            android:text="@string/AddText"
            android:textSize="20sp"
            android:textStyle="bold"

            android:layout_centerHorizontal="true"
            android:background="@drawable/button_rectangle"
            android:id="@+id/addBtn"
            />
    </RelativeLayout>

</FrameLayout>

